<odoo>
    <template
        id="report_purchaseorder_document"
        name="Purchase Order Report - Analytic and Payment Term"
        inherit_id="purchase.report_purchaseorder_document"
    >
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="o.payment_mode_id" class="col-3 bm-2">
                <strong>Payment Mode:</strong>
                <p t-field="o.payment_mode_id" class="m-0" />
            </div>
        </xpath>
        <xpath expr="//th[@name='th_amount']" position="before">
            <th name="th_analytic"><strong>Analytic Account</strong></th>
        </xpath>
        <xpath expr="//td[span[@t-field='line.price_subtotal']]" position="before">
            <td name="td_analytic">
                <t t-if="line.analytic_distribution">
                    <t
                        t-set="analytic_accounts"
                        t-value="env['account.analytic.account'].browse([int(k) for k in line.analytic_distribution.keys()])"
                    />
                    <span t-esc="', '.join(analytic_accounts.mapped('name'))" />
                </t>
            </td>
        </xpath>
        <xpath expr="//th[@name='th_date_req']/strong" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//th[@name='th_date_req']" position="inside">
            <strong>Data Entrega</strong>
        </xpath>
    </template>
</odoo>
